<Project>
  <!--
    Central Package Management: every NuGet version used in the solution lives here.

    EF Core and every package that depends on it are PINNED to the exact version the
    Oracle MySQL provider was built against (see docs/adr/0001-mysql-ef-core-provider.md).
    Do not bump EfCoreVersion until MySql.EntityFrameworkCore ships a matching release.
  -->
  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
    <CentralPackageTransitivePinningEnabled>true</CentralPackageTransitivePinningEnabled>
    <!-- EF Core and packages that depend on it: must match the MySQL provider. -->
    <EfCoreVersion>10.0.9</EfCoreVersion>
    <!-- ASP.NET Core packages with no EF dependency: keep on the latest patch for security fixes. -->
    <AspNetCoreVersion>10.0.13</AspNetCoreVersion>
  </PropertyGroup>

  <ItemGroup Label="Data access">
    <PackageVersion Include="MySql.EntityFrameworkCore" Version="10.0.9" />
    <PackageVersion Include="Microsoft.EntityFrameworkCore" Version="$(EfCoreVersion)" />
    <PackageVersion Include="Microsoft.EntityFrameworkCore.Relational" Version="$(EfCoreVersion)" />
    <PackageVersion Include="Microsoft.EntityFrameworkCore.Design" Version="$(EfCoreVersion)" />
    <PackageVersion Include="Microsoft.AspNetCore.Identity.EntityFrameworkCore" Version="$(EfCoreVersion)" />
    <PackageVersion Include="Microsoft.Extensions.Diagnostics.HealthChecks.EntityFrameworkCore" Version="$(EfCoreVersion)" />
    <PackageVersion Include="Microsoft.AspNetCore.DataProtection.EntityFrameworkCore" Version="$(EfCoreVersion)" />
  </ItemGroup>

  <ItemGroup Label="Security patches for transitive dependencies">
    <!--
      DataProtection.EntityFrameworkCore must stay on EfCoreVersion, but the 10.0.9 crypto libraries it
      pulls in have published advisories (NU1903). Transitive pinning lifts them to the patched runtime
      release. Remove these once EfCoreVersion moves past them.
    -->
    <PackageVersion Include="System.Security.Cryptography.Xml" Version="$(AspNetCoreVersion)" />
    <PackageVersion Include="System.Security.Cryptography.Pkcs" Version="$(AspNetCoreVersion)" />
  </ItemGroup>

  <ItemGroup Label="Web API">
    <PackageVersion Include="Microsoft.AspNetCore.OpenApi" Version="$(AspNetCoreVersion)" />
    <PackageVersion Include="Swashbuckle.AspNetCore.SwaggerUI" Version="10.3.0" />
    <PackageVersion Include="FluentValidation.DependencyInjectionExtensions" Version="12.2.0" />
  </ItemGroup>

  <ItemGroup Label="Testing">
    <PackageVersion Include="xunit.v3" Version="4.0.2" />
    <PackageVersion Include="Microsoft.AspNetCore.Mvc.Testing" Version="$(AspNetCoreVersion)" />
  </ItemGroup>
</Project>
